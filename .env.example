# Neon Postgres connection string (Neon dashboard -> Connect -> pooled connection)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Google AI Studio API key
GEMINI_API_KEY=your-gemini-api-key
# Current Gemini Flash model ID from Google AI Studio
GEMINI_MODEL=gemini-flash-model-id
# Telegram bot (from @BotFather) and Aarav's chat ID
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_ALLOWED_CHAT_ID=123456789
# Resend email
RESEND_API_KEY=re_your_key
BRIEF_TO_EMAIL=you@example.com
# Long random string; Vercel cron sends it automatically
CRON_SECRET=change-me-long-random-string
